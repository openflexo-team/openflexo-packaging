<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.openflexo</groupId>
	    <artifactId>openflexo-production</artifactId>
	    <version>0.5</version>
	</parent>
	<groupId>org.openflexo.packaging</groupId>
	<artifactId>openflexo-server-package</artifactId>
	<name>Diatomée - Openflexo Server</name>
	<properties>
		<product.name>Openflexo</product.name>
		<main.class>org.openflexo.http.server.OpenFlexoServer</main.class>
		<flexocore.version>2.99-SNAPSHOT</flexocore.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>packaging-tools</artifactId>
  	 	        <version>${project.parent.version}</version>
			<scope>compile</scope>
		</dependency>

		<!-- server -->
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>http-server</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- technology adapters -->
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>docx-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>xlsx-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>pdf-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>pptx-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>diagram-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>gina-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>jdbc-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.openflexo</groupId>
			<artifactId>kafka-ta</artifactId>
			<version>${flexocore.version}</version>
			<scope>runtime</scope>
		</dependency>
	</dependencies>
	<version>2.99-SNAPSHOT</version>

  <scm>
    <tag>2.99</tag>
  </scm>
</project>
